{
  "name": "bugsim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Procedural bug generator: gene vectors -> deterministic stats -> breeding GA -> 2D terrarium sim",
  "scripts": {
    "dev": "npx --yes serve -l 5173 .",
    "build": "node tools/build-single.mjs",
    "test": "node --test tests/*.test.js",
    "stage": "node tools/stage-deploy.mjs",
    "release": "npm run build && npm run stage",
    "test:viewport": "node tools/viewport-test.mjs",
    "test:interact": "node tools/interaction-test.mjs"
  },
  "devDependencies": {
    "phaser": "3.80.1",
    "playwright": "1.47.0"
  }
}
